<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme: no AppCompat, no animations that cost e-ink refreshes. -->
    <style name="Theme.Hachure" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
