<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Full screen: the rail and puck float above it and are excluded from inking. -->
    <app.hachure.ui.CanvasView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fixed size so text updates never change its rect (which would reopen the SDK). -->
    <TextView
        android:id="@+id/debug_overlay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/debug_overlay_height"
        android:layout_gravity="top"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        android:layout_marginTop="12dp"
        android:background="@color/debug_bg"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Shown while a ruler is selected. Wraps its buttons; excluded from inking while visible. -->
    <app.hachure.ui.GuideStrip
        android:id="@+id/guide_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />

    <app.hachure.ui.ToolDock
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
